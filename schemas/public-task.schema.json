{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zerglang.dev/schemas/benchmark-public-task-1.json",
  "title": "Contamination-safe public ZL256 task projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "revision", "title", "maturity", "category", "edition", "preview", "domains", "modalities", "tiers", "clauses", "boundaries", "execution", "cases", "synthesis", "performance", "limits", "provenance", "source"],
  "properties": {
    "schema": {"const": "zerglang.benchmark-public-task/1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"},
    "revision": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "maturity": {"enum": ["scaffold", "executable", "verified"]},
    "category": {"enum": ["shared", "algorithm", "compute", "state", "flow", "optimize", "integration"]},
    "edition": {"enum": ["core-0", "core-1"]},
    "preview": {"enum": ["shared", "compute", "state", "flow", "optimize", "stable"]},
    "domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "task.schema.json#/$defs/domain"}},
    "modalities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["interpreted", "compiled"]}},
    "tiers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["interpreter", "c", "llvm-jit", "aot"]}},
    "clauses": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "boundaries": {"type": "array", "items": {"$ref": "task.schema.json#/$defs/boundary"}},
    "execution": {"$ref": "task.schema.json#/$defs/execution"},
    "cases": {"type": "array", "items": {"$ref": "#/$defs/publicCase"}},
    "synthesis": {"$ref": "#/$defs/synthesis"},
    "performance": {"$ref": "task.schema.json#/$defs/performance"},
    "limits": {"$ref": "task.schema.json#/$defs/limits"},
    "provenance": {"type": "array", "items": {"$ref": "#/$defs/provenance"}},
    "source": {"$ref": "#/$defs/source"}
  },
  "$defs": {
    "publicOracle": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": {"enum": ["value", "trace", "history", "evidence"]},
            "value": {"$ref": "task.schema.json#/$defs/value"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "code"],
          "properties": {
            "kind": {"const": "diagnostic"},
            "code": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "availability", "reason"],
          "properties": {
            "kind": {"const": "property"},
            "availability": {"const": "withheld"},
            "reason": {"const": "executable-oracle-code"}
          }
        }
      ]
    },
    "publicCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "visibility", "input", "oracle"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "visibility": {"const": "public"},
        "input": {"$ref": "task.schema.json#/$defs/value"},
        "oracle": {"$ref": "#/$defs/publicOracle"}
      }
    },
    "synthesis": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["eligible"],
          "properties": {"eligible": {"const": false}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["eligible", "prompt", "interface", "contamination_warning"],
          "properties": {
            "eligible": {"const": true},
            "prompt": {"type": "string"},
            "interface": {"type": "string"},
            "contamination_warning": {"const": "Public candidate source may contaminate future model-synthesis evaluations."}
          }
        }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "license"],
      "properties": {
        "kind": {"enum": ["original", "adapted"]},
        "source": {"type": "string", "minLength": 1},
        "license": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "minLength": 1}
      }
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["availability", "reason"],
          "properties": {
            "availability": {"const": "withheld"},
            "reason": {"const": "active-synthesis-reference"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["availability", "entry", "files"],
          "properties": {
            "availability": {"const": "published"},
            "entry": {"$ref": "task.schema.json#/$defs/portablePath"},
            "files": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "sha256", "content"],
                "properties": {
                  "path": {"$ref": "task.schema.json#/$defs/portablePath"},
                  "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                  "content": {"type": "string"}
                }
              }
            }
          }
        }
      ]
    }
  }
}
