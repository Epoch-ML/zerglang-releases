{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zerglang.dev/schemas/benchmark-synthesis-report-1.json",
  "title": "ZergLang model synthesis report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "catalog_id", "profile_identity", "tasks"],
  "properties": {
    "schema": {"const": "zerglang.benchmark-synthesis-report/1"},
    "catalog_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tasks": {"type": "array", "items": {"$ref": "#/$defs/task"}}
  },
  "$defs": {
    "fraction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": {"type": "string", "pattern": "^[0-9]+$"},
        "denominator": {"type": "string", "pattern": "^[1-9][0-9]*$"}
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sample_index", "single_shot_pass", "repaired_pass", "repair_turns", "failure_kind", "backend"],
      "properties": {
        "sample_index": {"type": "integer", "minimum": 0},
        "single_shot_pass": {"type": "boolean"},
        "repaired_pass": {"type": "boolean"},
        "repair_turns": {"type": "integer", "minimum": 0, "maximum": 3},
        "failure_kind": {"type": ["string", "null"]},
        "backend": {"type": "object"}
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "task_revision", "samples", "pass_at_k", "repair_at_3"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "task_revision": {"type": "integer", "minimum": 1},
        "samples": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sample"}},
        "pass_at_k": {"type": "object", "propertyNames": {"pattern": "^[1-9][0-9]*$"}, "additionalProperties": {"$ref": "#/$defs/fraction"}},
        "repair_at_3": {
          "type": "object",
          "additionalProperties": false,
          "required": ["correct", "total", "rate"],
          "properties": {
            "correct": {"type": "integer", "minimum": 0},
            "total": {"type": "integer", "minimum": 1},
            "rate": {"$ref": "#/$defs/fraction"}
          }
        }
      }
    }
  }
}
