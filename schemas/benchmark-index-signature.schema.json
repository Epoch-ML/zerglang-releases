{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zerglang.dev/schemas/benchmark-index-signature.schema.json",
  "title": "Detached signature for the ZergLang benchmark discovery index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "algorithm", "key_id", "index_sha256", "value"],
  "properties": {
    "schema": {"const": "zerglang.benchmark-index-signature/1"},
    "algorithm": {"const": "Ed25519"},
    "key_id": {"type": "string", "pattern": "^zlbench-ed25519-[0-9]{4}-[0-9]{2}(?:-[a-z0-9-]+)?$"},
    "index_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "value": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
  }
}
